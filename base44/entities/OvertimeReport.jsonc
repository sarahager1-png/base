{
  "name": "OvertimeReport",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "hours": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05e9\u05e2\u05d5\u05ea"
    },
    "reason": {
      "type": "string",
      "description": "\u05e4\u05d9\u05e8\u05d5\u05d8 - \u05e2\u05dc \u05de\u05d4?"
    },
    "overtime_type": {
      "type": "string",
      "enum": [
        "regular",
        "special"
      ],
      "default": "regular",
      "description": "\u05e1\u05d5\u05d2 \u05e9\u05e2\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "paid"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "date",
    "hours",
    "reason"
  ]
}