{
  "name": "Absence",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "absence_reason": {
      "type": "string",
      "enum": [
        "sick_child",
        "other",
        "choice_day",
        "declaration_days"
      ],
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d4\u05d4\u05d9\u05e2\u05d3\u05e8\u05d5\u05ea"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd"
    },
    "lesson_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "hour_number": {
            "type": "number"
          },
          "subject": {
            "type": "string"
          },
          "class_name": {
            "type": "string"
          }
        }
      },
      "description": "\u05e9\u05e2\u05d5\u05ea \u05de\u05e2\u05e8\u05db\u05ea \u05e9\u05d1\u05d4\u05df \u05e0\u05e2\u05d3\u05e8\u05d4"
    },
    "medical_certificate_required": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05d3\u05e8\u05e9 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e8\u05e4\u05d5\u05d0\u05d9"
    },
    "medical_certificate_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 \u05e8\u05e4\u05d5\u05d0\u05d9"
    },
    "substitute_teacher_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05de\u05de\u05dc\u05d0\u05ea \u05d4\u05de\u05e7\u05d5\u05dd"
    },
    "substitute_teacher_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05de\u05dc\u05d0\u05ea \u05d4\u05de\u05e7\u05d5\u05dd"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "awaiting_certificate"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "reported_to_ministry": {
      "type": "boolean",
      "default": false,
      "description": "\u05d3\u05d5\u05d5\u05d7 \u05dc\u05de\u05e9\u05e8\u05d3 \u05d4\u05d7\u05d9\u05e0\u05d5\u05da"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "choice_days_used": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05d9\u05de\u05d9 \u05d1\u05d7\u05d9\u05e8\u05d4 \u05e0\u05d5\u05e6\u05dc\u05d5 \u05d4\u05e9\u05e0\u05d4"
    },
    "declaration_days_used": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05d9\u05de\u05d9 \u05d4\u05e6\u05d4\u05e8\u05d4 \u05e0\u05d5\u05e6\u05dc\u05d5 \u05d4\u05e9\u05e0\u05d4"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "absence_reason",
    "start_date",
    "end_date",
    "lesson_hours"
  ]
}