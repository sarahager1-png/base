{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05de\u05d9 \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd"
    },
    "participant_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05ea\u05e3/\u05ea (\u05d4\u05d5\u05e8\u05d4, \u05ea\u05dc\u05de\u05d9\u05d3, \u05d5\u05db\u05d5')"
    },
    "participant_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8"
    },
    "meeting_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "meeting_time": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "duration_minutes": {
      "type": "number",
      "default": 30,
      "description": "\u05de\u05e9\u05da \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4 \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "purpose": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d1\u05d9\u05d5\u05de\u05df \u05d2\u05d5\u05d2\u05dc"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05de\u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "participant_name",
    "meeting_date",
    "meeting_time",
    "purpose"
  ]
}