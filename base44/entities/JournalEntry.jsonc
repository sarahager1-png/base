{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05de\u05e4\u05d5\u05e8\u05d8"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "announcement",
        "reminder",
        "event",
        "holiday",
        "meeting"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "important",
        "urgent"
      ],
      "default": "normal",
      "description": "\u05e8\u05de\u05ea \u05d7\u05e9\u05d9\u05d1\u05d5\u05ea"
    },
    "visible_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "all"
      ],
      "description": "\u05dc\u05de\u05d9 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05d2\u05dc\u05d5\u05d9\u05d4"
    }
  },
  "required": [
    "date",
    "title",
    "content",
    "entry_type"
  ]
}