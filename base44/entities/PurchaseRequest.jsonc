{
  "name": "PurchaseRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05d1\u05e7\u05e9"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d1\u05e7\u05e9"
    },
    "item_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ],
      "default": "normal",
      "description": "\u05d3\u05d7\u05d9\u05e4\u05d5\u05ea"
    },
    "estimated_cost": {
      "type": "number",
      "description": "\u05e2\u05dc\u05d5\u05ea \u05de\u05e9\u05d5\u05e2\u05e8\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "ordered",
        "completed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "approval_document_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 \u05e8\u05db\u05e9 \u05dc\u05d4\u05d5\u05e8\u05d3\u05d4"
    },
    "approved_by": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d0\u05e9\u05e8"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d0\u05d9\u05e9\u05d5\u05e8"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "item_name",
    "reason"
  ]
}