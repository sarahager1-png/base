{
  "name": "Room",
  "type": "object",
  "properties": {
    "room_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8/\u05e9\u05dd \u05d4\u05d7\u05d3\u05e8"
    },
    "room_type": {
      "type": "string",
      "enum": [
        "classroom",
        "lab",
        "computer_room",
        "library",
        "multipurpose"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d7\u05d3\u05e8"
    },
    "capacity": {
      "type": "number",
      "description": "\u05e7\u05d9\u05d1\u05d5\u05dc\u05ea"
    },
    "building": {
      "type": "string",
      "description": "\u05d1\u05e0\u05d9\u05d9\u05df"
    },
    "floor": {
      "type": "number",
      "description": "\u05e7\u05d5\u05de\u05d4"
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u05e6\u05d9\u05d5\u05d3 \u05d1\u05d7\u05d3\u05e8"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "room_number",
    "room_type"
  ]
}