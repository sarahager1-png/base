{
  "name": "RoomBooking",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d7\u05d3\u05e8"
    },
    "room_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d7\u05d3\u05e8"
    },
    "teacher_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05d5\u05e8\u05d4"
    },
    "teacher_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e8\u05d4"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "recurring",
        "one_time"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05e4\u05d9\u05e1\u05d4"
    },
    "day_of_week": {
      "type": "number",
      "description": "\u05d9\u05d5\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 (0=\u05e8\u05d0\u05e9\u05d5\u05df, 6=\u05e9\u05d1\u05ea)"
    },
    "hour_number": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05e2\u05d4"
    },
    "specific_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 (\u05dc\u05ea\u05e4\u05d9\u05e1\u05d4 \u05d7\u05d3 \u05e4\u05e2\u05de\u05d9\u05ea)"
    },
    "subject": {
      "type": "string",
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "class_name": {
      "type": "string",
      "description": "\u05db\u05d9\u05ea\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "room_id",
    "room_number",
    "teacher_email",
    "teacher_name",
    "booking_type"
  ]
}