{
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8"
    },
    "avatar": {
      "type": "string",
      "description": "\u05d0\u05d5\u05ea \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05dc\u05d0\u05d5\u05d5\u05d8\u05e8"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "description": "\u05de\u05d2\u05d3\u05e8"
    },
    "copies_quota": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05db\u05e1\u05ea \u05e6\u05d9\u05dc\u05d5\u05de\u05d9\u05dd \u05e9\u05e0\u05d5\u05e6\u05dc\u05d4 \u05d4\u05d7\u05d5\u05d3\u05e9"
    },
    "hours_quota": {
      "type": "number",
      "default": 0,
      "description": "\u05e9\u05e2\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05e9\u05e0\u05d5\u05e6\u05dc\u05d5 \u05d4\u05e9\u05e0\u05d4"
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "completed"
      ],
      "default": "completed",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e7\u05dc\u05d9\u05d8\u05d4"
    },
    "is_new": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e2\u05d5\u05d1\u05d3 \u05d7\u05d3\u05e9 \u05e9\u05e6\u05e8\u05d9\u05da \u05dc\u05e2\u05d1\u05d5\u05e8 \u05e7\u05dc\u05d9\u05d8\u05d4"
    }
  },
  "name": "User",
  "type": "object",
  "required": [
    "title",
    "avatar",
    "gender"
  ]
}