        "pedagogic",
        "staff",
        "holiday",
        "meeting"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd"
    },
    "location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd"
    },
    "time": {
      "type": "string",
      "description": "\u05e9\u05e2\u05d4"
    }
  },
  "required": [
