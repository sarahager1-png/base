    },
    "start_date": {
      "type": "number",
      "description": "\u05d9\u05d5\u05dd \u05d1\u05d7\u05d5\u05d3\u05e9 - \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_date": {
      "type": "number",
      "description": "\u05d9\u05d5\u05dd \u05d1\u05d7\u05d5\u05d3\u05e9 - \u05e1\u05d9\u05d5\u05dd"
    },
    "event_type": {
      "type": "string",
      "enum": [
